# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Uploads & Dati sensibili o locali
/public/uploads/*
!/public/uploads/.gitkeep
/parsed_recipes.json

# Tooling locale e AI
/.claude
/graphify-out

# PWA Serwist generati
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/swe-worker-*.js
